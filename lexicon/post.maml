{
  defs: {
    main: {
      description: "A user's post or update."
      key: "tid"
      record: {
        properties: {
          createdAt: {
            description: "Timestamp when this post was originally created."
            format: "datetime"
            type: "string"
          }
          mentions: {
            description: "DIDs of users mentioned in the post."
            items: {
              format: "did"
              type: "string"
            }
            type: "array"
          }
          labels: {
            description: "The associated labels that the post has"
            items: {
              # Where each string is associated with an enum variant, not arbitrary
              type: "string"
            }
            type: "array"
          }
          replyTo: {
            description: "Reference to the post this is a reply to."
            ref: "com.atproto.repo.strongRef"
            type: "ref"
          }
          text: {
            description: "The content of the post."
            maxGraphemes: 1000
            maxLength: 3000
            type: "string"
          }
        }
        required: [
          "text"
          "createdAt"
        ]
        type: "object"
      }
      type: "record"
    }
  }
  id: "peerlink.post.main"
  lexicon: 1
}
