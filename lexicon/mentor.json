{
  "lexicon": 1,
  "id": "peerlink.mentor.intro",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A 20-minute introduction between a mentee and a mentor.",
      "record": {
        "type": "object",
        "required": [
          "menteeDid",
          "mentorDid",
          "introRequestAt",
          "duration"
        ],
        "properties": {
          "menteeDid": {
            "type": "string",
            "format": "did",
            "description": "The DID of the mentee requesting the introduction."
          },
          "mentorDid": {
            "type": "string",
            "format": "did",
            "description": "The DID of the mentor being introduced to."
          },
          "introRequestAt": {
            "type": "string",
            "format": "datetime",
            "description": "Timestamp when the introduction was requested."
          },
          "duration": {
            "type": "integer",
            "description": "Expected duration of the introduction in minutes (e.g., 20).",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "knownValues": [
              "peerlink.defs#pending",
              "peerlink.defs#accepted",
              "peerlink.defs#completed",
              "peerlink.defs#declined"
            ],
            "default": "peerlink.defs#pending"
          }
        }
      }
    }
  }
}