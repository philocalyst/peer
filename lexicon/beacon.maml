{
  defs: {
    main: {
      description: "An anonymous invitation beacon."
      key: "tid"
      record: {
        properties: {
          createdAt: {
            description: "Timestamp when the beacon was created."
            format: "datetime"
            type: "string"
          }
          expiresAt: {
            description: "Timestamp when the beacon expires."
            format: "datetime"
            type: "string"
          }
          message: {
            description: "The message content of the beacon invite."
            maxLength: 500
            type: "string"
          }
          targetCourse: {
            description: "A course subject this beacon is targeting."
            type: "string"
          }
          targetInterest: {
            description: "An interest this beacon is targeting."
            type: "string"
          }
        }
        required: [
          "message"
          "createdAt"
        ]
        type: "object"
      }
      type: "record"
    }
  }
  id: "peerlink.beacon.main"
  lexicon: 1
}